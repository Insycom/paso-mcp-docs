    {
      "name": "crear_comprobante",
      "description": "Registra FC/NC/ND interna. Contado cancela automáticamente. Reutilizá la clave solo al reintentar la misma operación.",
      "inputSchema": {
        "$defs": {
          "Comprobante": {
            "additionalProperties": false,
            "properties": {
              "operacion": {
                "enum": [
                  "venta",
                  "compra"
                ],
                "title": "Operacion",
                "type": "string"
              },
              "tipo": {
                "default": "FC",
                "enum": [
                  "FC",
                  "NC",
                  "ND"
                ],
                "title": "Tipo",
                "type": "string"
              },
              "tercero_id": {
                "exclusiveMinimum": 0,
                "title": "Tercero Id",
                "type": "integer"
              },
              "fecha": {
                "format": "date",
                "title": "Fecha",
                "type": "string"
              },
              "moneda_id": {
                "exclusiveMinimum": 0,
                "title": "Moneda Id",
                "type": "integer"
              },
              "letra": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "E"
                ],
                "title": "Letra",
                "type": "string"
              },
              "impuesto_id": {
                "exclusiveMinimum": 0,
                "title": "Impuesto Id",
                "type": "integer"
              },
              "condicion_id": {
                "exclusiveMinimum": 0,
                "title": "Condicion Id",
                "type": "integer"
              },
              "cotizacion": {
                "anyOf": [
                  {
                    "exclusiveMinimum": 0.0,
                    "maximum": 10000000.0,
                    "type": "number"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Cotizacion"
              },
              "numero_externo": {
                "anyOf": [
                  {
                    "maxLength": 60,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Numero Externo"
              },
              "aplica_impuestos": {
                "default": true,
                "title": "Aplica Impuestos",
                "type": "boolean"
              },
              "lineas": {
                "items": {
                  "$ref": "#/$defs/Linea"
                },
                "maxItems": 100,
                "minItems": 1,
                "title": "Lineas",
                "type": "array"
              }
            },
            "required": [
              "operacion",
              "tercero_id",
              "fecha",
              "moneda_id",
              "letra",
              "impuesto_id",
              "condicion_id",
              "lineas"
            ],
            "title": "Comprobante",
            "type": "object"
          },
          "Linea": {
            "additionalProperties": false,
            "properties": {
              "detalle": {
                "maxLength": 250,
                "minLength": 1,
                "title": "Detalle",
                "type": "string"
              },
              "cantidad": {
                "anyOf": [
                  {
                    "exclusiveMinimum": 0.0,
                    "maximum": 1000000.0,
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ],
                "title": "Cantidad"
              },
              "precio": {
                "anyOf": [
                  {
                    "maximum": 999999999.0,
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ],
                "title": "Precio"
              }
            },
            "required": [
              "detalle",
              "cantidad",
              "precio"
            ],
            "title": "Linea",
            "type": "object"
          }
        },
        "properties": {
          "tenant_id": {
            "exclusiveMinimum": 0,
            "title": "Tenant Id",
            "type": "integer"
          },
          "datos": {
            "$ref": "#/$defs/Comprobante"
          },
          "clave_idempotencia": {
            "pattern": "^[A-Za-z0-9_.:-]{8,120}$",
            "title": "Clave Idempotencia",
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "datos",
          "clave_idempotencia"
        ],
        "title": "crear_comprobanteArguments",
        "type": "object"
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "crear_comprobanteDictOutput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
